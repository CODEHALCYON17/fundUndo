# --- LLM used to extract structured opportunities from messy HTML pages ---
# Any OpenAI-compatible /chat/completions endpoint works. Free options:
#
#   Groq (recommended default - fast, generous free tier, no card):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_API_KEY=<from https://console.groq.com/keys>
#     LLM_MODEL=openai/gpt-oss-120b
#     Groq's Llama chat models (3.3 70B, 3.1 8B) were retired as of this
#     writing - gpt-oss-120b/20b and the Qwen models are what's actually
#     live. Get the current list for YOUR key with:
#       curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"
#
#   OpenRouter (many free ":free" models, smaller daily quota):
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_API_KEY=<from https://openrouter.ai/keys>
#     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   Google Gemini (OpenAI-compat endpoint, big token budget):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_API_KEY=<from https://aistudio.google.com/apikey>
#     LLM_MODEL=gemini-2.5-flash-lite
#
#   Local Ollama (fully free, no API key, nothing leaves your machine):
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_API_KEY=ollama
#     LLM_MODEL=llama3.1
#
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Email delivery (SMTP) ---
# Works with Gmail (use an App Password: https://myaccount.google.com/apppasswords),
# or any other SMTP provider (Resend, SendGrid, your own mail server, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Who the digest is sent to / from
DIGEST_TO=g4gregorykurien@gmail.com
DIGEST_FROM=
